#!/bin/sh
# Jibo mode query: prints the mode from /var/jibo/mode.json. Was a node script; init scripts run it 4 times per boot
# and each node start took 0.3-1.5 s on Jibo.
mode=$(sed -n 's/.*"mode" *: *"\([^"]*\)".*/\1/p' /var/jibo/mode.json 2>/dev/null | head -n 1)
[ -n "$mode" ] || { echo "ERROR: failed to parse /var/jibo/mode.json"; exit 1; }
echo "$mode"
