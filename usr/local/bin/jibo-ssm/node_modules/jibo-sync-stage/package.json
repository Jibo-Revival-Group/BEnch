  },
  "publishConfig": {
    "registry": "http://npm.jibo.media.mit.edu:8081/repository/private/"
  },
  "description": "Library for the staging project for syncing.",
  "main": "lib/jibo-sync-stage.js",
  "bin": {
    "sync-stage": "bin/sync-stage.js"
  },
  "scripts": {
    "build": "gulp debug",
    "build:release": "gulp",
    "clean": "gulp clean",
    "coverage:check": "istanbul check-coverage --statements 20 --branches 20 --functions 30 --lines 20",
    "coverage:report": "istanbul report && open coverage/lcov-report/index.html",
    "coverage:remap": "remap-istanbul --input ./coverage/coverage-final.json --output ./coverage/coverage-final.json -b jibo-sync-stage/",
    "watch": "gulp watch",
    "test": "gulp test  && istanbul report && yarn coverage:check",
    "test:report": "gulp test-report"
  },
  "typings": "lib/dts/index.d.ts",
