    "node": ">=6.0"
  },
  "dependencies": {
    "chalk": "^1.1.3",
    "find-node-modules": "^1.0.4",
    "fs-extra": "^4.0.0",
    "minimist": "^1.2.0"
  },
  "files": [
    "bin",
    "lib"
  ],
  "devDependencies": {
    "@types/fs-extra": "^4.0.0",
    "@types/node": "6.0.94",
