  "version": "1.0.5",
  "main": "lib/utils-common.js",
  "typings": "lib/dts/index.d.ts",
  "scripts": {
    "build": "gulp debug",
    "clean": "rm -rf ./lib/ ./test/ ./node_modules/ ./ts-node-*/",
    "watch": "gulp watch",
    "test": "mocha -r ts-node/register ./tests/index.ts",
    "test:debug": "yarn run test --inspect-brk=0.0.0.0:5850",
    "docker:interactive": "../../scripts/docker-run.js -i -d packages/utils-common",
    "docker:run": "../../scripts/docker-run.js -d packages/utils-common -- ",
    "docker:build": "yarn run docker:run yarn run build",
    "docker:test": "yarn run docker:run yarn run test",
    "docker:test:debug": "../../scripts/docker-run.js -d packages/utils-common -p 5850 -- yarn run test:debug"
  },
  "devDependencies": {
    "@types/node": "6.0.94",
    "@types/uuid": "^3.4.2",
    "chai": "^4.0.2",
    "mocha": "^4.1.0",
    "ts-node": "^4.1.0"
  },
  "dependencies": {
    "find-root": "^1.1.0",
    "jibo-cai-utils": "^6.0.1",
    "uuid": "^3.1.0"
  },
  "files": [
    "lib",
    "resources",
    "mims",
    "*.env",
    "manifest.json",
    "scripts"
  ],
  "publishConfig": {
    "registry": "http://npm.jibo.com:8080"
  },
