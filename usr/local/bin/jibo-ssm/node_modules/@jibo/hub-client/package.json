  "typings": "lib/dts/index.d.ts",
  "scripts": {
    "build": "gulp debug",
    "build:test": "gulp debug; gulp test",
    "clean": "rm -rf ./lib/ ./test/ ./node_modules/ ./ts-node-*/",
    "watch": "gulp watch",
    "test": "mocha -r ts-node/register ./tests/index.js",
    "test:debug": "yarn run test --inspect-brk=0.0.0.0:5850",
    "docker:interactive": "../../scripts/docker-run.js -i -d packages/hub-client",
    "docker:run": "../../scripts/docker-run.js -d packages/hub-client -- ",
    "docker:build": "yarn run docker:run yarn run build",
    "docker:test": "yarn run docker:run yarn run test",
    "docker:test:debug": "../../scripts/docker-run.js -d packages/hub-client -p 5850 -- yarn run test:debug"
  },
  "devDependencies": {
    "@types/chai": "^4.0.1",
    "@types/mocha": "^2.2.41",
    "@types/node": "6.0.94",
    "@types/ws": "^3.2.0",
