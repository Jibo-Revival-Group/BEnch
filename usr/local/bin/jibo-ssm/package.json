{
  "name": "skills-service-manager",
  "version": "16.0.0",
  "description": "Skills Services Manager",
  "author": "Jibo, Inc.",
  "license": "UNLICENSED",
  "distribution": "PROPRIETARY AND CONFIDENTIAL - NOT FOR DISTRIBUTION",
  "copyright": "Copyright (c) 2014-2018 Jibo, Inc. All Rights Reserved",
  "main": "index.js",
  "scripts": {
    "build": "gulp debug",
    "build:release": "gulp",
    "test": "gulp test  && istanbul report && yarn coverage:check",
    "test:report": "gulp test-report",
    "test:debug": "gulp test --debug",
    "clean": "gulp clean-all",
    "coverage:check": "istanbul check-coverage --statements 20 --branches 10 --functions 20 --lines 10",
    "coverage:report": "istanbul report && open coverage/lcov-report/index.html",
    "coverage:remap": "remap-istanbul --input ./coverage/coverage-final.json --output ./coverage/coverage-final.json -b packages/",
    "watch": "gulp watch",
    "postinstall": "node postinstall",
    "sync": "./bin/on-robot/sync-to-robot.sh",
    "wait": "./bin/wait-for-start.sh",
    "robot": "./bin/run-on-robot.sh",
    "robot:force": "rimraf .staged && ./bin/run-on-robot.sh",
    "robot:clear": "./bin/clear-on-robot.sh",
    "addsshkey": "./bin/utils/add-ssh-key.sh",
    "buildroot": "node bin/utils/buildroot.js"
  },
  "publicScripts": {
    "postinstall": "node postinstall"
  },
  "files": [
    "index.*",
    "jibo-*.js",
    "expression-main.js",
    "postinstall.js",
    "skill-main.js",
    "bin",
    "configs",
    "lib",
    "resources",
    "startup",
    "static",
    "npm-shrinkwrap.json"
  ],
  "publicFiles": [
    "index.*",
    "jibo-*.js",
    "postinstall.js",
    "skill-main.js",
    "configs",
    "lib",
    "resources",
    "startup",
    "static",
    "npm-shrinkwrap.json"
  ],
  "monorailConfig": {
    "shrinkwrap": true,
    "output": [
      "lib",
      "static/performance",
      "static/skills-service",
      "static/error-service"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git@github.jibo.com:sdk/sdk.git"
  },
  "publishConfig": {
    "registry": "http://npm.jibo.media.mit.edu:8081/repository/private/"
  },
  "parser": {
    "version": "2.4.0",
    "type": "50"
  },
  "engines": {
    "node": ">=6.0"
  },
