#!/bin/sh
# System-manager invokes this for each start/restart. exec preserves signals/PID.
set -e
[ "$#" -ge 2 ] || { echo 'Usage: jibo-service-start SERVICE EXECUTABLE [ARGS...]' >&2; exit 2; }
service=$1
shift
case "$service" in
    ssm) /usr/local/bin/jibo-runtime-bootstrap --service ssm --knowledge
         rm -f /run/jibo-runtime-ready  # SSM starts last: services restarted from now on prepare their own state again
         /usr/local/bin/jibo-mic-access || true ;;  # skills' getUserMedia: the live mic, not the Dummy card
    resolv-watcher|jibo-bluetooth) ;;  # 5x1 helpers with no runtime state to prepare
    # At boot S04 already prepared every service (and left this marker); a node start per service cost ~0.75 s each.
    *) [ -e /run/jibo-runtime-ready ] || /usr/local/bin/jibo-runtime-bootstrap --service "$service" ;;
esac
# system-manager starts services one at a time, each after the last posts Jibo's startup semaphore. Post it now for
# 5x1 helpers (they never do: 10 s wait each) and for services nothing waits on at boot, so they start side by side
# on Jibo's 4 cores. Not lps: expression never comes up if it starts before lps is ready. Not body/audio/asr/jetstream.
# exec below keeps this PID.
case "$service" in resolv-watcher|jibo-bluetooth|jibo-sync-helper|tts|identity|server|monitor|media|security-controller-service|secure-transfer|expression)
    NODE_PATH=/usr/lib/node_modules /usr/bin/node -e "require('node-semaphore').Semaphore('/jibo-startup-$$.event').post()" || true ;;
esac
# Speaker path on the sound chip (what the OS's /root/OutAudioSetup.sh sets at boot): if that file is lost, Jibo is silent.
if [ "$service" = audio ]; then
    for c in "DACL Route=1" "DACR Route=1" "DAC Volume=127,127" "DAC Switch=on,on" "Headphone Driver Gain=0,0" \
        "Headphone Driver Switch=on,on" "Headphone Volume=117,117" "Headphone Switch=on,on"; do
        amixer -c TLV320DAC3100 -q cset name="${c%%=*}" "${c#*=}" || true
    done
fi
# TTS: route speech through the 5x1 voice effects (vibrato/volume) when the plugin is installed.
if [ "$service" = tts ] && [ -f /usr/local/lib/ladspa/jibo_voicefx.so ] && [ -f /usr/local/share/ttsservice/alsa/.asoundrc ] && [ -f /opt/jibo/Knowledge/beacon/voices/fx.txt ]; then
    export HOME=/usr/local/share/ttsservice/alsa
fi
# Node services reuse V8's compiled code between boots (usr/local/lib/jibo/code-cache.js).
if [ "$1" = /usr/bin/node ] && [ -f /usr/local/lib/jibo/code-cache.js ]; then
    shift
    set -- /usr/bin/node -r /usr/local/lib/jibo/code-cache.js "$@"
fi
# lps (camera + face detection) uses over a core nonstop; at lower priority it no longer slows the rest of boot.
[ "$service" = lps ] && set -- nice -n 10 "$@"
exec "$@"
