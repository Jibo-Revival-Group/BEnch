#!/usr/bin/node
'use strict';
var runtime = require('../lib/jibo/runtime-state');
var args = process.argv.slice(2);
var options = {};
var knowledge = false;
while (args.length) {
    var name = args.shift();
    if (name === '--knowledge') { knowledge = true; continue; }
    if ((name === '--root' || name === '--service') && args.length) {
        options[name.slice(2)] = args.shift();
    } else { console.error('Usage: jibo-runtime-bootstrap [--root DIR] [--service NAME] [--knowledge]'); process.exit(2); }
}
try { runtime.ensure(options); }
catch (err) { console.error('[bootstrap] ' + err.message); process.exit(1); }

if (knowledge) {
    var path = require('path');
    var child = require('child_process');
    var root = options.root ? path.resolve(options.root) : '';
    var lock = root + '/var/jibo/.knowledge-bootstrap-flock';
    var result = child.spawnSync('/usr/bin/flock', ['-w', '30', lock, process.execPath,
        require.resolve('../lib/jibo/knowledge-bootstrap'), JSON.stringify(options)], { stdio: 'inherit' });
    if (result.error) { console.error('[bootstrap] ' + result.error.message); }
    process.exit(result.status === null ? 1 : result.status);
}
