#!/bin/sh
# Restore an unusable resolver file without replacing an existing symlink.
set -eu
LC_ALL=C
export LC_ALL
RESOLV_FILE=${RESOLV_FILE:-/etc/resolv.conf}
INTERVAL=${RESOLV_WATCH_INTERVAL:-60}
RUN_ONCE=${RESOLV_WATCH_ONCE:-0}
BACKUP='nameserver 8.8.8.8
nameserver 8.8.4.4
'

valid_ipv4() {
    ipv4_address=$1
    case "$ipv4_address" in ''|*[!0-9.]*|.*|*..*|*.) return 1 ;; esac
    ipv4_saved_ifs=$IFS
    IFS=.
    set -- $ipv4_address
    IFS=$ipv4_saved_ifs
    [ "$#" -eq 4 ] || return 1
    for octet do
        case "$octet" in
            [0-9]|[0-9][0-9]|[0-1][0-9][0-9]|2[0-4][0-9]|25[0-5]) ;;
            *) return 1 ;;
        esac
    done
}

valid_hextets() {
    segment=$1
    IPV6_GROUPS=0
    [ -n "$segment" ] || return 0
    case "$segment" in *[!0-9A-Fa-f:]* ) return 1 ;; esac
    saved_ifs=$IFS
    IFS=:
    set -- $segment
    IFS=$saved_ifs
    for group do
        case "$group" in ''|?????*|*[!0-9A-Fa-f]*) return 1 ;; esac
    done
    IPV6_GROUPS=$#
}

valid_ipv6() {
    address=$1
    case "$address" in *:*) ;; *) return 1 ;; esac
    case "$address" in *[!0-9A-Fa-f:.]* ) return 1 ;; esac
    prefix=$address
    extra_groups=0
    case "$address" in
        *.*)
            ipv4_tail=${address##*:}
            valid_ipv4 "$ipv4_tail" || return 1
            prefix=${address%:*}
            [ "$prefix" != "$address" ] || return 1
            case "$prefix" in *:) prefix=${prefix}: ;; esac
            extra_groups=2
            ;;
    esac
    case "$prefix" in *::*::* ) return 1 ;; esac
    case "$prefix" in
        *::* )
            before=${prefix%%::*}
            after=${prefix#*::}
            case "$after" in *::* ) return 1 ;; esac
            if [ -n "$before" ]; then valid_hextets "$before" || return 1; before_groups=$IPV6_GROUPS; else before_groups=0; fi
            if [ -n "$after" ]; then valid_hextets "$after" || return 1; after_groups=$IPV6_GROUPS; else after_groups=0; fi
            total=$((before_groups + after_groups + extra_groups))
            [ "$total" -lt 8 ]
            ;;
        *)
            valid_hextets "$prefix" || return 1
            total=$((IPV6_GROUPS + extra_groups))
            [ "$total" -eq 8 ]
            ;;
    esac
}

valid_nameserver() {
    valid_ipv4 "$1" || valid_ipv6 "$1"
}

check_resolver() {
    if [ ! -f "$RESOLV_FILE" ]; then
        printf '%s' "$BACKUP" > "$RESOLV_FILE"
        return
    fi

    found_nameserver=0
    set -f
    while :; do
        line=
        if IFS= read -r line; then
            :
        elif [ -n "$line" ]; then
            :
        else
            break
        fi
        set -- $line
        if [ "$#" -ge 2 ] && [ "$1" = nameserver ] && valid_nameserver "$2"; then
            found_nameserver=1
            break
        fi
    done < "$RESOLV_FILE"
    if [ "$found_nameserver" -ne 1 ]; then
        # Redirection follows a symlink; deliberately do not use mv/rename.
        printf '%s' "$BACKUP" > "$RESOLV_FILE"
    fi
}

while :; do
    check_resolver
    [ "$RUN_ONCE" = 1 ] && exit 0
    sleep "$INTERVAL"
done
