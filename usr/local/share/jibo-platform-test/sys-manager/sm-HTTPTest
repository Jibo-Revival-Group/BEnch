describe('System Manager HTTP Tests', function() {

    before(function() {
        this.request = {
            'POST': Common._post,
            'GET': Common._get
        };
    });

    for(let i = 0; i < testList.length; i++) {
        const test = testList[i];
        it('Testing the ' + test.url.substring(1).split("?")[0] + ' API', function(done) {
            this.request[test.type]("localhost", test.url, 8585, test.args, function(error, response, body) {
                assert(!error, 'Error ' + error);
                if (test.statusExpect){
                    assert(response.statusCode == test.statusExpect,
                        'Unexpected status code ' + response.statusCode
                    );
                }else{
                    assert(response.statusCode < 300,
                        'Bad status code ' + response.statusCode);
                    if (test.type == "GET"){
                        assert(body, 'Response body is undefined');
                    }
                }
                done();
            });
        });
    }
    after(function() {
        console.log("- Finished testing the system manager HTTP APIs");
    });
});
