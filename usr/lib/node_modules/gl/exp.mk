

TOOL_PATH=/home/todd/Projects/buildroot.jibo/output/host/usr/bin
TOOL_PREFIX=arm-buildroot-linux-gnueabihf
CXX=$(TOOL_PATH)/$(TOOL_PREFIX)-g++
CC=$(TOOL_PATH)/$(TOOL_PREFIX)-gcc

ANGLE_DIR=angle
ANGLE_SAMPLES_DIR=$(ANGLE_DIR)/samples

LIBRARY_LINE=./build/Release/angle_util.a ./build/Release/EGL.a ./build/Release/GLESv2.a  ./build/Release/ANGLE.a ./build/Release/ANGLE.a  ./build/Release/translator_static.a ./build/Release/translator_lib.a ./build/Release/preprocessor.a ./build/Release/angle_common.a ./build/Release/XNVCtrl.a -lXi -lXext -lX11 -ldl

all: hello_triangle simple_vertex_shader simple_texture_cubemap particle_system simple_instancing stencil_operations


hello_triangle: $(ANGLE_SAMPLES_DIR)/hello_triangle/HelloTriangle.cpp
	$(CXX) -DGL_GLEXT_PROTOTYPES=1 -pthread -std=c++11 -O3 -o $@ -I$(ANGLE_DIR)/include -I$(ANGLE_DIR)/util -I$(ANGLE_DIR)/src/ -I$(ANGLE_SAMPLES_DIR)/sample_util $(ANGLE_SAMPLES_DIR)/sample_util/*.cpp  $<  $(LIBRARY_LINE)


simple_vertex_shader: $(ANGLE_SAMPLES_DIR)/simple_vertex_shader/SimpleVertexShader.cpp
	$(CXX) -DGL_GLEXT_PROTOTYPES=1 -pthread -std=c++11 -O3 -o $@ -I$(ANGLE_DIR)/include -I$(ANGLE_DIR)/util -I$(ANGLE_DIR)/src/ -I$(ANGLE_SAMPLES_DIR)/sample_util $(ANGLE_SAMPLES_DIR)/sample_util/*.cpp  $<  $(LIBRARY_LINE)


simple_texture_cubemap: $(ANGLE_SAMPLES_DIR)/simple_texture_cubemap/SimpleTextureCubemap.cpp
	$(CXX) -DGL_GLEXT_PROTOTYPES=1 -pthread -std=c++11 -O3 -o $@ -I$(ANGLE_DIR)/include -I$(ANGLE_DIR)/util -I$(ANGLE_DIR)/src/ -I$(ANGLE_SAMPLES_DIR)/sample_util $(ANGLE_SAMPLES_DIR)/sample_util/*.cpp  $<  $(LIBRARY_LINE)

particle_system: $(ANGLE_SAMPLES_DIR)/particle_system/ParticleSystem.cpp
	$(CXX) -DGL_GLEXT_PROTOTYPES=1 -pthread -std=c++11 -O3 -o $@ -I$(ANGLE_DIR)/include -I$(ANGLE_DIR)/util -I$(ANGLE_DIR)/src/ -I$(ANGLE_SAMPLES_DIR)/sample_util $(ANGLE_SAMPLES_DIR)/sample_util/*.cpp  $<  $(LIBRARY_LINE)

simple_instancing: $(ANGLE_SAMPLES_DIR)/simple_instancing/SimpleInstancing.cpp
	$(CXX) -DGL_GLEXT_PROTOTYPES=1 -pthread -std=c++11 -O3 -o $@ -I$(ANGLE_DIR)/include -I$(ANGLE_DIR)/util -I$(ANGLE_DIR)/src/ -I$(ANGLE_SAMPLES_DIR)/sample_util $(ANGLE_SAMPLES_DIR)/sample_util/*.cpp  $<  $(LIBRARY_LINE)


stencil_operations: $(ANGLE_SAMPLES_DIR)/stencil_operations/StencilOperations.cpp
	$(CXX) -DGL_GLEXT_PROTOTYPES=1 -pthread -std=c++11 -O3 -o $@ -I$(ANGLE_DIR)/include -I$(ANGLE_DIR)/util -I$(ANGLE_DIR)/src/ -I$(ANGLE_SAMPLES_DIR)/sample_util $(ANGLE_SAMPLES_DIR)/sample_util/*.cpp  $<  $(LIBRARY_LINE)


clean:
	rm -f hello_triangle
	rm -f simple_vertex_shader
	rm -f simple_texture_cubemap
	rm -f particle_system
	rm -f simple_instancing
	rm -f stencil_operations



